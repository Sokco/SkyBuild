{
    "version": 2,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "vcpkg",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_TARGET_TRIPLET": "x64-windows-skse",
                "VCPKG_HOST_TRIPLET": "x64-windows-skse",
                "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake",
                "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL"
            }
        },
        {
            "name": "win32-unicode",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_CXX_FLAGS": "/DWIN32_LEAN_AND_MEAN /DNOMINMAX /DUNICODE /D_UNICODE"
            }
        },
        {
            "name": "build-debug-msvc",
            "inherits": [
                "vcpkg",
                "win32-unicode"
            ],
            "displayName": "Debug",
            "description": "Debug build for testing.",
            "generator": "Visual Studio 17 2022",
            "architecture": {
                "value": "x64",
                "strategy": "set"
            },
            "binaryDir": "${sourceDir}/build/msvc"
        },
        {
            "name": "build-release-msvc",
            "inherits": [
                "vcpkg",
                "win32-unicode"
            ],
            "displayName": "Release",
            "description": "Optimized release build.",
            "generator": "Visual Studio 17 2022",
            "architecture": {
                "value": "x64",
                "strategy": "set"
            },
            "binaryDir": "${sourceDir}/build/msvc"
        }
    ],
    "buildPresets": [
        {
            "name": "relwithdebinfo-msvc",
            "displayName": "Release with debug symbols (MSVC)",
            "configurePreset": "build-release-msvc",
            "configuration": "RelWithDebInfo"
        },
        {
            "name": "release-msvc",
            "displayName": "Release (MSVC)",
            "configurePreset": "build-release-msvc",
            "configuration": "Release"
        },
        {
            "name": "debug-msvc",
            "displayName": "Debug (MSVC)",
            "configurePreset": "build-debug-msvc",
            "configuration": "Debug"
        }
    ]
}
